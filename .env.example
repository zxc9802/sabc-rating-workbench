# Server-side only. Never use NEXT_PUBLIC_ for secrets.
SABC_PLANNER_BASE_URL=https://api.openlux.ai/v1
SABC_PLANNER_API_KEY=
# Analysis model key; main model address/name configured in the application.
# OpenLux connections use Gemini 3.8 Flash first via native generateContent with this same key.
# Fallbacks retain fal GLM (one retry), OpenLux Luna, then DeepSeek when configured.
SABC_API_KEY=

# Cloud deployment (no trailing slash in origin).
SABC_MODEL_BASE_URL=https://api.openlux.ai/v1
SABC_MODEL=glm-5.3-flash
SABC_VISION_MODEL=gpt-5.6-luna
SABC_REQUIRE_AUTH=1
SABC_ACCESS_PASSWORD=
SABC_UI_ORIGIN=https://YOUR-DOMAIN
# Persist the entire /data directory, including sabc-sso.db. Keep the SSO client secret stable across restarts.
SABC_DB=/data/sabc.db

# Shanghai collector: private server-to-server only. Base64 of the trusted PEM certificate.
SABC_COLLECTOR_URL=
SABC_COLLECTOR_TOKEN=
SABC_COLLECTOR_CA_B64=

# DeepSeek is used only after the role-specific model fails.
# Each new answer request starts with Gemini on OpenLux; source selection uses embeddings.
SABC_DEEPSEEK_BASE_URL=https://api.deepseek.com
SABC_DEEPSEEK_MODEL=deepseek-flash
SABC_DEEPSEEK_REASONING_EFFORT=max
SABC_DEEPSEEK_API_KEY=

# Production main-site SSO (separate client from legacy sabc)
SABC_AUTH_MODE=sso
SABC_SSO_MAIN_ORIGIN=https://www.qycm.top
SABC_SSO_CLIENT_SECRET=

# Vector source selection. Legacy planner credentials can be reused; no planner chat call.
SABC_EMBEDDING_MODEL=text-embedding-3-large
SABC_EMBEDDING_BASE_URL=https://api.openlux.ai/v1
SABC_EMBEDDING_API_KEY=

# Doubao streaming voice input (server only)
SABC_SPEECH_API_KEY=
SABC_SPEECH_RESOURCE_ID=volc.seedasr.sauc.duration
